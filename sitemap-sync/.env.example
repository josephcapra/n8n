# ── Source sitemap ────────────────────────────────────────────────────────────
# Default URL — override with --source-url or --source-file at runtime
SOURCE_SITEMAP_URL=http://paradiserealtyfla.com/sitemap.xml

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_PROJECT=paradise-automation
GCS_BUCKET=site-map-dynamic-page3
GCS_PREFIX=sitemaps/

# ── Site URLs ─────────────────────────────────────────────────────────────────
# SITE_URL: used as the verified property in GSC and the siteUrl in Bing API
SITE_URL=https://www.paradiserealtyfla.com/
# REDIRECT_BASE_URL: base for /sitemapN/ feedpaths (usually same as SITE_URL)
REDIRECT_BASE_URL=https://www.paradiserealtyfla.com/

# ── RealGeeks ─────────────────────────────────────────────────────────────────
# Login URL — the script follows the OAuth redirect to login.realgeeks.com automatically
REALGEEKS_LOGIN_URL=https://www.paradiserealtyfla.com/admin/

# Redirects admin list (Django admin). Confirm this URL after first login.
REALGEEKS_REDIRECTS_URL=https://www.paradiserealtyfla.com/admin/redirects/redirect/

REALGEEKS_USER=
REALGEEKS_PASS=

# Persistent Chromium profile — session cookies saved here so you stay logged in
# Default: ~/.sitemap-sync-browser
BROWSER_DATA_DIR=~/.sitemap-sync-browser

# ── Bing Webmaster Tools ──────────────────────────────────────────────────────
BING_API_KEY=d49f8705515a4259b7d6f4fb256f04dd

# ── Google credentials ────────────────────────────────────────────────────────
# Uses Application Default Credentials — no key file needed.
# Run once: gcloud auth application-default login \
#   --scopes=https://www.googleapis.com/auth/webmasters,https://www.googleapis.com/auth/cloud-platform

# Agent-Manager connector credentials — TEMPLATE (safe to commit).
# Copy to `.env` (which is gitignored) and fill in real values. The master
# loads `.env` at startup so the assistant can use these connectors.

# --- LLM providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- RealGeeks (CRM site + Leads API) ---
REALGEEKS_USER=
REALGEEKS_PASS=
REALGEEKS_URL=https://YOURSITE.realgeeks.com
RG_API_BASE=https://leadrouter.realgeeks.com
RG_SITE_UUID=
RG_GRANT_URL=
RG_PASSWORD=

# --- Other available services ---
BING_API_KEY=
SENDGRID_API_KEY=
GCS_PROJECT=
GCS_BUCKET=
GCS_PREFIX=

# --- Google Drive (uses gcloud ADC with drive.readonly scope; no key) ---
GOOGLE_DRIVE_ENABLED=1
